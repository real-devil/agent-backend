OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# comma-separated, e.g. http://localhost:3000,http://127.0.0.1:3000
BACKEND_CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# memory | postgres
LANGGRAPH_CHECKPOINTER=memory

# One of the following is required when LANGGRAPH_CHECKPOINTER=postgres
# LANGGRAPH_POSTGRES_URL=postgresql://user:pass@host:5432/db
# DATABASE_URL=postgresql://user:pass@host:5432/db
# POSTGRES_URL=postgresql://user:pass@host:5432/db

# Optional integration-test document id
# TEST_DOCUMENT_ID=
